# TrueFit app environment — copy to .env and fill in. Never commit .env.
# Only EXPO_PUBLIC_* values are bundled into the app; they are public by design (RLS protects data).

# Supabase (local: run `npm run db:start` and copy "API URL" and "anon key")
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In — OAuth "Web application" client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# RevenueCat public Android SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_public_key

# Sentry DSN (leave empty to disable in development)
EXPO_PUBLIC_SENTRY_DSN=

# development | preview | production
EXPO_PUBLIC_APP_ENV=development
